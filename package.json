{
  "name": "sommersstore",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/dashboard_server.js",
    "lint": "node scripts/quality/lint.cjs",
    "typecheck": "node scripts/quality/typecheck.cjs",
    "test": "node tests/quality/master_hub.test.cjs",
    "sync:ide": "node .aiox-core/infrastructure/scripts/ide-sync/index.js sync",
    "sync:ide:check": "node .aiox-core/infrastructure/scripts/ide-sync/index.js validate --strict",
    "sync:skills:codex": "node .aiox-core/infrastructure/scripts/codex-skills-sync/index.js",
    "sync:skills:codex:global": "node .aiox-core/infrastructure/scripts/codex-skills-sync/index.js --global",
    "sync:mirror": "node scripts/project_mirror_sync.js sync --trigger npm_manual",
    "sync:mirror:install": "node scripts/install_project_mirror_hook.js && node scripts/install_project_mirror_schedule.js",
    "migration:plan": "node scripts/pc_migration_bundle.js plan",
    "migration:prepare": "node scripts/pc_migration_bundle.js prepare",
    "migration:verify": "node scripts/pc_migration_bundle.js verify",
    "migration:transport": "node scripts/pc_migration_bundle.js transport",
    "migration:verify-transport": "node scripts/pc_migration_bundle.js verify-transport",
    "migration:restore": "node scripts/pc_migration_bundle.js restore",
    "continuity:install-restic": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_restic.ps1",
    "continuity:install-rclone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_rclone.ps1",
    "continuity:secret": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aiox_continuity_secret.ps1 set",
    "continuity:preflight": "node scripts/aiox_continuity.js preflight",
    "continuity:init": "node scripts/aiox_continuity.js init",
    "continuity:backup": "node scripts/aiox_continuity.js backup --trigger npm_manual",
    "continuity:handoff": "node scripts/aiox_continuity.js backup --handoff-source --trigger notebook_handoff",
    "continuity:claim": "node scripts/aiox_continuity.js claim-primary",
    "continuity:status": "node scripts/aiox_continuity.js status",
    "continuity:verify": "node scripts/aiox_continuity.js verify",
    "continuity:verify:sample": "node scripts/aiox_continuity.js verify --sample",
    "continuity:restore": "node scripts/aiox_continuity.js restore",
    "continuity:restore:apply": "node scripts/aiox_continuity.js restore --apply",
    "continuity:schedule": "node scripts/install_aiox_continuity_schedule.js",
    "deploy:hosting": "node scripts/deploy_hosting_with_mirror.js",
    "validate:structure": "node .aiox-core/infrastructure/scripts/validate-paths.js",
    "validate:agents": "node .aiox-core/infrastructure/scripts/validate-agents.js",
    "close:day": "node scripts/daily_close.cjs",
    "close:day:push": "node scripts/daily_close.cjs --push",
    "logs:backfill:project-id": "node scripts/maintenance/backfill_project_log_ids.cjs",
    "personas:clean-md": "node scripts/maintenance/clean_persona_markdown_assets.cjs",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google-cloud/aiplatform": "^6.5.0",
    "dompurify": "^3.4.1",
    "dotenv": "^17.4.2",
    "firebase": "^12.12.0",
    "google-auth-library": "^10.6.2",
    "jsdom": "^29.1.0",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^4.4.0",
    "puppeteer": "^24.40.0",
    "tesseract.js": "^6.0.1",
    "turndown": "^7.2.4",
    "youtube-transcript": "^1.3.0",
    "yt-dlp-wrap": "^2.3.12",
    "ytdl-core": "^4.11.5"
  }
